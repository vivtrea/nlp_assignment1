# Copy to .env and fill in. Without a key the system runs in rule-based (baseline) mode.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=baidu/ernie-5.5-flash-preview:free
# Optional: separate judge model for LLM-as-judge evals
JUDGE_MODEL=nvidia/nemotron-3.5-super-vl:free
